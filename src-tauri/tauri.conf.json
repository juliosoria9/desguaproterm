{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desguaproterm",
  "mainBinaryName": "desguaproterm",
  "version": "1.0.0",
  "identifier": "dev.julio.desguaproterm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "incognito": true,
        "title": "desguaproterm",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 440,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
